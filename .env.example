# Database runtime values only; never use the privileged migrator account here.
# DEALSHIELD_DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/path/to/certificate.cer
# DEALSHIELD_DB_USER=
# DEALSHIELD_DB_PASSWORD=
# Flyway uses separate FLYWAY_URL, FLYWAY_USER, and FLYWAY_PASSWORD environment variables.
# Auth values stay on the backend. A publishable key is safe for client identification,
# but this application still enters it privately and never logs it. Never use service_role.
# DEALSHIELD_AUTH_PROJECT_URL=https://PROJECT_REF.supabase.co
# DEALSHIELD_AUTH_PUBLISHABLE_KEY=
# DEALSHIELD_AUTH_CALLBACK_URL=http://localhost:5173/api/v1/auth/callback
# Defaults to DEALSHIELD_AUTH_CALLBACK_URL with /callback replaced by /recovery.
# Set explicitly only if the hosted app uses a distinct same-origin recovery callback.
# DEALSHIELD_AUTH_RECOVERY_CALLBACK_URL=http://localhost:5173/api/v1/auth/recovery
# DEALSHIELD_COOKIE_SECURE=false
# Production must use HTTPS and DEALSHIELD_COOKIE_SECURE=true.
# GEMINI_API_KEY=
